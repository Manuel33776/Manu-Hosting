{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "ManuHostingAgent": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "Url": "https://manu-hosting.de",
    "ApiPort": 8443,
    "NodeId": "dl580-node-01",
    "NodeToken": "CHANGE_ME_GENERATE_SECURE_TOKEN",
    "VerifySsl": true
  },
  "Agent": {
    "InstallDir": "D:\\ManuHosting",
    "ServersDir": "D:\\ManuHosting\\servers",
    "BackupsDir": "D:\\ManuHosting\\backups",
    "TempDir": "D:\\ManuHosting\\temp",
    "LogDir": "D:\\ManuHosting\\logs",
    "JavaPath": "java",
    "HeartbeatInterval": 30,
    "CommandPollInterval": 5,
    "ResourceReportInterval": 60,
    "IdleShutdownDefault": 60,
    "MaxIdleShutdown": 900
  },
  "Minecraft": {
    "DefaultJavaVersion": "21",
    "DefaultRam": 2048,
    "DefaultCpu": 2,
    "DefaultDisk": 10240,
    "MaxPlayers": 20,
    "JavaVersions": ["21", "17", "11", "8"]
  },
  "Process": {
    "ShutdownTimeout": 30,
    "ForceKillAfter": 10,
    "JvmArgs": [
      "-Xms{ram}M",
      "-Xmx{ram}M",
      "-XX:+UseG1GC",
      "-XX:+ParallelRefProcEnabled",
      "-XX:MaxGCPauseMillis=200",
      "-XX:+UnlockExperimentalVMOptions",
      "-XX:+DisableExplicitGC",
      "-XX:+AlwaysPreTouch",
      "-XX:G1NewSizePercent=30",
      "-XX:G1MaxNewSizePercent=40",
      "-XX:G1HeapRegionSize=8M",
      "-XX:G1ReservePercent=20",
      "-XX:G1HeapWastePercent=5",
      "-XX:G1MixedGCCountTarget=4",
      "-XX:InitiatingHeapOccupancyPercent=15",
      "-XX:G1MixedGCLiveThresholdPercent=90",
      "-XX:G1RSetUpdatingPauseTimePercent=5",
      "-XX:SurvivorRatio=32",
      "-Dusing.aikars.flags=https://mcflags.emc.gs",
      "-Daikars.new.flags=true"
    ]
  },
  "Backup": {
    "Compression": "zip",
    "MaxBackupsPerServer": 10,
    "ExcludePatterns": [
      "*.log",
      "*.tmp",
      "cache/*",
      "plugins/dynmap/*",
      "logs/*",
      "crash-reports/*"
    ]
  },
  "Network": {
    "PortRangeStart": 25565,
    "PortRangeEnd": 25665,
    "BindAddress": "0.0.0.0"
  },
  "Security": {
    "AllowedIps": [],
    "MutualTls": false
  }
}
